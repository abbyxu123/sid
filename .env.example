# Copy to .env.local and fill local secrets. Do not commit .env.local.

STEPFUN_API_KEY=replace_with_stepfun_key
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.5-flash

# Local model services
STEP_BASE_URL=http://100.112.48.0:8080
KITTEN_BASE_URL=http://100.112.48.0:8081

USE_MODEL=1
USE_KITTEN=1

# Device gateway: fast local ASR and optional public H5/mini-program bridge.
ASR_MODEL=tiny
PUBLIC_BASE_URL=
